#!/bin/sh
# 앵커 검사 — 파일이나 디렉터리가 생겼는데 그 자리 CLAUDE.md 에 안 적힌 채로
# 커밋되는 것을 막는다. 이 저장소에서 문서가 낡는 경로는 사실상 이것 하나다.
#
# 설치:  make hooks        (또는 git config core.hooksPath .githooks)
# 우회 (환경별):  Bash  SKIP_ANCHOR=1 git commit ...
#                 CMD   set SKIP_ANCHOR=1 && git commit ... && set SKIP_ANCHOR=
#
# 규칙을 사람이 기억해서 치는 한 지켜지지 않는다는 것을 이 저장소에서 이미
# 확인했다 (전파 절차 11단계가 전부 기계 강제 0건이었고, 그 결과 구조 정본이
# 파생 문서보다 낡아 있었다). 이 훅이 그 발동 시점이다.

[ -n "$SKIP_ANCHOR" ] && exit 0

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

PY=$(command -v python3 || command -v python)
if [ -z "$PY" ]; then
    echo "pre-commit: python 을 못 찾아 앵커 검사를 건너뛴다"
    exit 0
fi

if ! "$PY" anchor.py; then
    echo ""
    echo "  ─ 커밋을 멈췄다 ────────────────────────────────────────────"
    echo "  위에 적힌 CLAUDE.md 에 한 줄씩 넣고 다시 커밋한다."
    echo "  지금 당장 넘겨야 한다면 — 환경에 맞는 것 하나:"
    echo "      Git Bash     SKIP_ANCHOR=1 git commit ..."
    echo "      CMD          set SKIP_ANCHOR=1 && git commit ... && set SKIP_ANCHOR="
    echo '      PowerShell   $env:SKIP_ANCHOR=1; git commit ...; Remove-Item Env:SKIP_ANCHOR'
    echo "  ────────────────────────────────────────────────────────────"
    exit 1
fi

# 스테이지된 파이썬 파일 구문 검사 — 깨진 파일이 main 에 들어가는 것만 막는다
staged=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')
if [ -n "$staged" ]; then
    if ! "$PY" -m py_compile $staged; then
        echo "pre-commit: 구문 오류 — 커밋 중단"
        exit 1
    fi
fi

# ── 상태 줄 넛지 — 알리기만 한다 ─────────────────────────────────────────────
# 앵커(A1)는 **새 파일**만 본다. 기존 파일의 내용이 바뀌는 것은 아무도 안 보는데,
# 협업에서 실제로 자주 일어나는 건 그쪽이다. 코드가 바뀌었는데 그 자리 `상태` 줄이
# 그대로면 `make status` 는 남에게 **옛 값을 자신 있게** 보여준다 — 비어 있는 것보다 나쁘다.
#
# 막지 않는 이유: 상태가 정말 안 바뀌는 변경(오타·주석·리팩터)이 훨씬 많다.
# 그것까지 막으면 규칙이 일을 방해하고, 방해하는 규칙은 우회된다.
changed=$(git diff --cached --name-only --diff-filter=ACM)

# ── 소유 경계 경고 (D-17) — 막지 않는다 ──────────────────────────────────────
# 이 트리의 **코드**는 담당 연구원 소유다. 다른 사람은 읽고 결함을 기록할 뿐 고치지 않는다.
# 2026-08-06 에 생태계 담당이 이 경계를 넘어 8개 파일을 고쳤고 전부 되돌렸다 —
# 그때 있던 기계 장치(옛 DA-6, 보존 blob 고정)는 폐기됐고 대체가 없었다.
# 담당자 배정이 없어 CODEOWNERS 를 못 쓰고, `master` 는 직접 푸시라 리뷰도 못 막는다.
# 그래서 막지 않고 **묻는다.** 담당자 본인이면 OWNER=1 로 넘긴다.
# 각 트리의 CLAUDE.md 는 우리가 만든 규범이라 예외다.
if [ -z "$OWNER" ]; then
    crossed=$(printf '%s\n' "$changed" \
        | grep -E '^(worker_ai_agent/limo-MCP|tools/limo-patrol-viz)/' \
        | grep -v '/CLAUDE\.md$')
    if [ -n "$crossed" ]; then
        echo ""
        echo "  ─ 소유 경계 (D-17) — 커밋은 그대로 진행된다 ────────────────"
        echo "  담당 연구원 소유 트리의 코드가 스테이지돼 있다:"
        printf '%s\n' "$crossed" | sed 's/^/      /'
        echo ""
        echo "  담당자 본인이면 그대로 커밋한다 (OWNER=1 로 이 안내를 끈다)."
        echo "  아니라면 되돌리고 docs/safety/ 또는 docs/status-defects.md 에 결함만 남긴다."
        echo "  ────────────────────────────────────────────────────────────"
    fi
fi

nudge=""
while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in CLAUDE.md | */CLAUDE.md) continue ;; esac
    d=$(dirname "$f")
    while [ "$d" != "." ] && [ ! -f "$d/CLAUDE.md" ]; do d=$(dirname "$d"); done
    [ "$d" = "." ] && continue                       # 루트는 넛지하지 않는다 (생태계 파일)
    printf '%s\n' "$changed" | grep -qxF "$d/CLAUDE.md" && continue
    case " $nudge " in *" $d "*) continue ;; esac
    nudge="$nudge $d"
done <<CHANGED
$changed
CHANGED

if [ -n "$nudge" ]; then
    echo ""
    echo "  ─ 알림 — 커밋은 그대로 진행된다 ────────────────────────────"
    echo "  아래 디렉터리의 파일이 바뀌었는데 그 CLAUDE.md 는 그대로다."
    echo "  상태가 달라졌다면 '> **상태**' 줄 한 줄만 고친다 — make status 가 그 줄을 읽고,"
    echo "  그게 다른 협업자가 당신의 진척을 보는 유일한 자리다."
    for d in $nudge; do echo "      $d/CLAUDE.md"; done
    echo "  ────────────────────────────────────────────────────────────"
fi

exit 0
