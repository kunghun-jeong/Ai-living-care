#!/bin/sh
# 브랜치는 2단이다 (CONTRIBUTING 「브랜치」).
#
#   main     최종본 — master 를 검토한 뒤 승격한다
#   master   협업자가 일하는 곳 — 여기로 커밋·푸시한다
#
# 이 훅은 `main` 으로 가는 푸시 중 **master 를 거치지 않은 것**만 거부한다.
# 승격(master 를 병합한 커밋, 또는 master 와 같은 커밋)은 그냥 통과한다 —
# 소유자가 매 사이클 탈출구를 쓰게 되면 탈출구가 일상이 되고 훅은 의미를 잃는다.
#
# stdin 으로 "<local ref> <local sha> <remote ref> <remote sha>" 가 줄 단위로 들어온다.

[ -n "$SKIP_MAIN_PUSH" ] && exit 0

zero=0000000000000000000000000000000000000000
blocked=""

# 승격인가 — 밀려는 커밋이 (a) master 자신이거나 (b) master 를 부모로 갖는 **병합 커밋**인가.
# (b) 에서 병합 여부를 함께 보는 이유: main 과 master 가 같은 지점일 때(정상 상태) main 에
# 직접 커밋하면 그 부모가 곧 master 라 부모만 보면 승격과 구분되지 않는다.
masters() {
    git rev-parse -q --verify refs/remotes/origin/master
    git rev-parse -q --verify refs/heads/master
}

is_promotion() {
    for ms in $(masters); do
        [ "$1" = "$ms" ] && return 0          # (a) fast-forward 승격
    done
    parents=$(git rev-list --parents -n 1 "$1" 2>/dev/null | cut -d' ' -f2-)
    [ "$(echo $parents | wc -w)" -lt 2 ] && return 1   # 병합이 아니면 승격이 아니다
    for ms in $(masters); do
        for p in $parents; do
            [ "$p" = "$ms" ] && return 0      # (b) master 를 병합한 커밋
        done
    done
    return 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            [ "$local_sha" = "$zero" ] && continue   # 삭제는 판단하지 않는다
            is_promotion "$local_sha" && continue    # 승격 — 통과
            blocked=1
            ;;
    esac
done

[ -z "$blocked" ] && exit 0

cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
echo "pre-push: master 를 거치지 않은 변경은 main 으로 갈 수 없다. 푸시 중단"
echo
echo "  현재 브랜치: $cur"
echo "  main 에서 직접 작업한 것으로 보인다. master 로 옮겨 붙인다:"
echo
echo "      git switch master && git pull"
echo "      git cherry-pick <커밋>          # 또는 처음부터 master 에서 작업"
echo "      git push"
echo
echo "  승격은 master 를 병합하면 그냥 통과한다:"
echo "      git switch main && git pull && git merge master && git push origin main"
echo "  또는 GitHub 에서 master -> main PR (권장 — CI 가 한 번 더 돈다)"
echo
echo "  그래도 넘겨야 하면 — 환경에 맞는 것 하나:"
echo "      Git Bash     SKIP_MAIN_PUSH=1 git push origin main"
echo "      CMD          set SKIP_MAIN_PUSH=1 && git push origin main && set SKIP_MAIN_PUSH="
echo '      PowerShell   $env:SKIP_MAIN_PUSH=1; git push origin main; Remove-Item Env:SKIP_MAIN_PUSH'
exit 1
