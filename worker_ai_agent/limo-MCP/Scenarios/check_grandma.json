{
  "scenario_id": "check_grandma",
  "label": "기본 — 식탁부터 시계방향 (시나리오 1의 원래 순서)",
  "input": {
    "intent": "check_obj",
    "object": "person"
  },
  "note": "경로는 하드코딩이다 — LLM 은 순서를 짜지 않고 이 시나리오(또는 파생 버전)를 고르기만 한다. 구역 이름은 manager_ai_agent/knowledge_graph/entities.json 의 엔티티다. 좌표는 tools/limo-patrol-viz/WORLD.md §2 에서 계산한 값. 팀 합의에 따라 시작점과 도착점은 같다 — 마지막에 항상 home(3.5,1.0)으로 돌아온다.",
  "steps": [
    {
      "id": "z1_resolve",
      "type": "call",
      "layer": "reasoning",
      "tool": "resolve_location",
      "args": {
        "name": "dining_area"
      },
      "next": "z1_plan"
    },
    {
      "id": "z1_plan",
      "type": "call",
      "layer": "reasoning",
      "tool": "pathplanning",
      "args": {
        "x": "$z1_resolve.x",
        "y": "$z1_resolve.y",
        "frame": "$z1_resolve.frame"
      },
      "next": "z1_move"
    },
    {
      "id": "z1_move",
      "type": "call",
      "layer": "action",
      "tool": "moving_path",
      "args": {
        "waypoints": "$z1_plan.waypoints"
      },
      "next": "z1_arrive"
    },
    {
      "id": "z1_arrive",
      "type": "poll_until_match",
      "layer": "action",
      "tool": "get_path_status",
      "args": {},
      "match": {
        "field": "status",
        "equals": "succeeded"
      },
      "stop_when": {
        "tool": "get_path_status",
        "field": "status",
        "equals": "failed"
      },
      "poll_interval": 0.5,
      "timeout": 180.0,
      "next": "z1_look"
    },
    {
      "id": "z1_look",
      "type": "call",
      "layer": "action",
      "tool": "look_around",
      "args": {
        "steps": 8,
        "step_deg": 45,
        "step_duration": 1.0
      },
      "next": "z1_scan"
    },
    {
      "id": "z1_scan",
      "type": "poll_until_match",
      "layer": "reasoning",
      "tool": "detect_objects",
      "args": {
        "min_conf": 0.4
      },
      "match": {
        "field": "detections",
        "class_field": "class",
        "target": "$input.object"
      },
      "stop_when": {
        "tool": "is_looking_around",
        "field": "looking_around",
        "equals": false
      },
      "interrupt": {
        "tool": "interrupt_look_around"
      },
      "poll_interval": 0.5,
      "timeout": 30.0,
      "next": "z1_found"
    },
    {
      "id": "z1_found",
      "type": "branch",
      "condition": "z1_scan.matched",
      "on_true": "state_check",
      "on_false": "z2_resolve"
